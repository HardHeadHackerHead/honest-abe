{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window: recording, hotkeys, pasting, settings and provider keys.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:app:allow-version",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-set-size",
    "core:window:allow-scale-factor",
    "core:window:allow-inner-size",
    "os:allow-platform",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }]
    },
    "allow-start-recording",
    "allow-stop-recording",
    "allow-get-audio-devices",
    "allow-set-audio-device",
    "allow-get-audio-level",
    "allow-check-voice-detected",
    "allow-set-push-to-talk",
    "allow-reduce-other-apps-volume",
    "allow-restore-other-apps-volume",
    "allow-paste-text",
    "allow-paste-last-transcription",
    "allow-get-selected-text",
    "allow-set-hotkey",
    "allow-set-paste-last-hotkey",
    "allow-set-transform-hotkey",
    "allow-set-hotkeys-enabled",
    "allow-show-overlay",
    "allow-hide-overlay",
    "allow-open-window",
    "allow-is-updater-enabled",
    "allow-needs-desktop-shortcuts",
    "allow-get-engine-status",
    "allow-transcribe-recording",
    "allow-transform-text",
    "allow-set-api-key",
    "allow-has-api-key",
    "allow-delete-api-key",
    "allow-test-api-key",
    "allow-list-local-models",
    "allow-download-local-model",
    "allow-cancel-local-model-download",
    "allow-delete-local-model"
  ]
}
