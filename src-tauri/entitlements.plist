<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened runtime: required for microphone capture. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Outgoing connections (updater, and provider APIs called from Rust).
         Only enforced if the app is ever sandboxed; harmless otherwise. -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
