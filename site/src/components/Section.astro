---
interface Props {
  id: string;
  label: string;
  title: string;
  intro?: string;
  narrow?: boolean;
}
const { id, label, title, intro, narrow = false } = Astro.props;
---

<section id={id} class="mx-auto mt-28 max-w-6xl scroll-mt-24 px-4 sm:mt-36 sm:px-6" aria-labelledby={`${id}-title`}>
  <div class:list={['mb-10 sm:mb-12', narrow ? 'mx-auto max-w-3xl' : 'max-w-2xl']}>
    <p class="label">{label}</p>
    <h2 id={`${id}-title`} class="mt-3 text-3xl font-semibold leading-tight tracking-[-0.03em] sm:text-[2.6rem]">{title}</h2>
    {intro && <p class="mt-4 text-lg leading-relaxed">{intro}</p>}
  </div>
  <div class:list={[narrow && 'mx-auto max-w-3xl']}>
    <slot />
  </div>
</section>
