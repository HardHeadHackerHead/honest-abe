---
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../lib/github';

interface Props {
  title: string;
  description: string;
  updated: string;
}
const { title, description, updated } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="mx-auto max-w-3xl px-4 pt-16 sm:px-6 sm:pt-24">
    <header>
      <p class="label">Legal</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-[-0.035em] sm:text-5xl">{title}</h1>
      <p class="mt-4 text-sm text-outline">Last updated {formatDate(updated)}</p>
    </header>
    <div class="prose-abe mt-10 text-[1.02rem]">
      <slot />
    </div>
  </article>
</BaseLayout>
