---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroDemo from '../components/HeroDemo.astro';
import DownloadButton from '../components/DownloadButton.astro';
import PrivacyDiagram from '../components/PrivacyDiagram.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import GitHubIcon from '../components/GitHubIcon.astro';
import Section from '../components/Section.astro';
import KeycapField from '../components/KeycapField.astro';
import { GITHUB_URL, SITE_URL, SITE_DESCRIPTION, LICENSE_NAME, DONATE_URL } from '../config/site';
import { DICTATE, HOTKEYS } from '../data/hotkeys';
import { FAQ } from '../data/faq';
import { TRANSCRIPTION_PRICES, PRICES_AS_OF, perHour, formatUsd } from '../data/pricing';
import { getLatestRelease, formatDate } from '../lib/github';

const release = await getLatestRelease();
const transformKeys = HOTKEYS.find((h) => h.id === 'transform')!.windows;

const priceCards = [
  TRANSCRIPTION_PRICES.find((p) => p.provider === 'Local')!,
  TRANSCRIPTION_PRICES.find((p) => p.model === 'whisper-large-v3-turbo')!,
  TRANSCRIPTION_PRICES.find((p) => p.model === 'whisper-large-v3')!,
  TRANSCRIPTION_PRICES.find((p) => p.model === 'gpt-transcribe')!,
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Abe',
    alternateName: 'Honest Abe',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Windows 10, Windows 11, macOS',
    description: SITE_DESCRIPTION,
    url: SITE_URL,
    downloadUrl: `${SITE_URL}/download`,
    license: 'https://www.gnu.org/licenses/agpl-3.0.html',
    isAccessibleForFree: true,
    ...(release ? { softwareVersion: release.version } : {}),
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    author: { '@type': 'Organization', name: 'Quads Lab', url: SITE_URL },
  },
];

const steps = [
  {
    n: '01',
    title: 'Install',
    body: 'Download Abe for Windows or macOS (Linux is coming soon). It lives quietly in your tray or menu bar.',
    icon: 'download',
  },
  {
    n: '02',
    title: 'Choose your engine',
    body: 'Pick Local to run Whisper offline on your own machine, or paste an API key. We recommend Groq: free to start, and our guide takes five minutes.',
    icon: 'key',
    link: { href: '/docs/api-keys/groq', label: 'Get a Groq key' },
  },
  {
    n: '03',
    title: 'Hold the hotkey and talk',
    body: 'Put your cursor anywhere, hold the hotkey, speak, let go. Your words appear right where you were typing.',
    icon: 'mic',
  },
] as const;
---

<BaseLayout jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="hero relative overflow-hidden" aria-labelledby="hero-title">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-16 px-4 pb-24 pt-14 sm:px-6 sm:pt-20 lg:grid-cols-[1.05fr_1fr] lg:gap-10 lg:pb-32 lg:pt-24">
      <div class="max-w-xl">
        <p class="inline-flex flex-wrap items-center gap-x-2 gap-y-1 rounded-full bg-surface-high/70 px-3.5 py-1.5 text-xs font-medium text-on-surface-variant shadow-[inset_0_0_0_1px_var(--abe-ghost-border)]">
          <span class="h-1.5 w-1.5 rounded-full bg-tertiary shadow-glow-tertiary"></span>
          Free forever <span class="text-outline-variant" aria-hidden="true">/</span> Open source <span class="text-outline-variant" aria-hidden="true">/</span> No account
        </p>
        <h1 id="hero-title" class="mt-7 text-[2.75rem] font-semibold leading-[1.02] tracking-[-0.035em] sm:text-6xl lg:text-[4.4rem]">
          Talk anywhere.
          <span class="hero-gradient block">Free, open source, private.</span>
        </h1>
        <p class="mt-6 max-w-lg text-lg leading-relaxed text-on-surface-variant">
          Hold a hotkey, say what you mean, and Abe types it into any app on your desktop. Run Whisper offline on your own
          machine, or bring your own API key. No subscription, no servers in between.
        </p>
        <div class="mt-9 flex flex-col gap-4 sm:flex-row sm:items-start">
          <DownloadButton version={release?.version} />
          <a href={GITHUB_URL} class="btn btn-ghost !min-h-[3.4rem] !px-6 !text-base">
            <GitHubIcon size={19} />
            View on GitHub
          </a>
        </div>
        <p class="mt-8 flex flex-wrap items-center gap-2 text-sm text-outline">
          Try it: hold
          {DICTATE.windows.map((k) => <kbd class="kbd">{k}</kbd>)}
          and talk.
        </p>
      </div>
      <div class="pb-10 lg:pb-0">
        <HeroDemo />
      </div>
    </div>
  </section>

  <!-- Proof strip -->
  <section aria-label="At a glance" class="mx-auto max-w-6xl px-4 sm:px-6">
    <ul class="grid grid-cols-2 gap-3 md:grid-cols-4">
      {
        [
          ['$0', 'Forever. No plans, no trials.'],
          ['0', 'Accounts to create'],
          ['0', 'Abe servers touching your audio'],
          ['100%', 'Open source, AGPL-3.0'],
        ].map(([big, small]) => (
          <li class="card px-5 py-6">
            <p class="text-3xl font-semibold tracking-tight text-on-surface sm:text-4xl">{big}</p>
            <p class="mt-1.5 text-sm">{small}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- How it works -->
  <Section id="how" label="How it works" title="Three steps. About two minutes." intro="No sign-up, no email, no onboarding funnel.">
    <ol class="grid gap-4 md:grid-cols-3">
      {
        steps.map((s) => (
          <li class="card group relative overflow-hidden p-7">
            <span class="absolute right-6 top-5 font-mono text-5xl font-semibold text-surface-highest transition-colors group-hover:text-surface-bright" aria-hidden="true">
              {s.n}
            </span>
            <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-surface-high text-primary">
              <Icon name={s.icon} size={20} />
            </span>
            <h3 class="mt-6 text-lg font-semibold">{s.title}</h3>
            <p class="mt-2 leading-relaxed">{s.body}</p>
            {'link' in s && (
              <a href={s.link.href} class="relative mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-primary underline-offset-4 hover:underline">
                {s.link.label} <Icon name="arrow" size={14} />
              </a>
            )}
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- Features -->
  <Section id="features" label="Features" title="Built for people who type all day." intro="Everything happens with a hotkey, wherever your cursor is.">
    <div class="bento grid gap-4 md:grid-cols-6">
      <!-- System-wide -->
      <article class="card relative overflow-hidden p-7 md:col-span-4">
        <span class="feature-icon"><Icon name="globe" /></span>
        <h3 class="mt-5 text-xl font-semibold">Dictate into any app</h3>
        <p class="mt-2 max-w-md leading-relaxed">
          Email, Slack, Docs, your code editor, a terminal. If it has a text cursor, Abe can write there. No plugins, no
          copy and paste.
        </p>
        <ul class="mt-6 flex flex-wrap gap-2" aria-label="Examples">
          {['Mail', 'Chat', 'Docs', 'Browser', 'IDE', 'Terminal', 'Notes', 'CRM'].map((a) => (
            <li class="rounded-full bg-surface-high px-3 py-1 text-xs font-medium text-on-surface">{a}</li>
          ))}
        </ul>
      </article>

      <!-- PTT / toggle -->
      <article class="card p-7 md:col-span-2">
        <span class="feature-icon"><Icon name="keyboard" /></span>
        <h3 class="mt-5 text-xl font-semibold">Push-to-talk or toggle</h3>
        <p class="mt-2 leading-relaxed">Hold the hotkey while you speak, or tap once to start and again to stop. Your call.</p>
        <p class="mt-5 flex flex-wrap gap-1.5">{DICTATE.windows.map((k) => <kbd class="kbd">{k}</kbd>)}</p>
      </article>

      <!-- Transform -->
      <article class="card relative overflow-hidden p-7 md:col-span-3">
        <span class="feature-icon"><Icon name="wand" /></span>
        <h3 class="mt-5 text-xl font-semibold">Voice Transform</h3>
        <p class="mt-2 leading-relaxed">
          Select text, hold <span class="whitespace-nowrap">{transformKeys.map((k) => <kbd class="kbd mx-0.5">{k}</kbd>)}</span> and say what you want:
          "make it formal", "turn this into bullets", "translate to Spanish".
        </p>
        <div class="mt-6 grid gap-2 text-sm">
          <p class="rounded-lg bg-surface-lowest px-4 py-3 text-outline line-through decoration-outline-variant">hey can u send me the report by friday thx</p>
          <p class="rounded-lg bg-surface-high px-4 py-3 text-on-surface">
            Hi, could you please send me the report by Friday? Thank you.
          </p>
        </div>
      </article>

      <!-- Dictionary -->
      <article class="card p-7 md:col-span-3">
        <span class="feature-icon"><Icon name="book" /></span>
        <h3 class="mt-5 text-xl font-semibold">Word dictionary</h3>
        <p class="mt-2 leading-relaxed">
          Teach Abe the names, jargon and spellings it keeps getting wrong. It fixes them every time.
        </p>
        <dl class="mt-6 grid gap-2 font-mono text-[0.8rem]">
          {[
            ['cooper netties', 'Kubernetes'],
            ['post gress', 'PostgreSQL'],
            ['shivon', 'Siobhan'],
          ].map(([from, to]) => (
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 rounded-lg bg-surface-container px-4 py-2.5">
              <dt class="text-outline">{from}</dt>
              <dd class="flex items-center gap-3 text-tertiary"><Icon name="arrow" size={14} class="text-outline" />{to}</dd>
            </div>
          ))}
        </dl>
      </article>

      <!-- Small features -->
      {
        [
          ['volume', 'Audio ducking', 'Music and videos get quieter while you talk, then come back.'],
          ['history', 'History', 'Every transcription is kept on your computer, searchable, until you clear it.'],
          ['type', 'Typewriter mode', 'For apps that block pasting, Abe types your words out key by key.'],
        ].map(([icon, title, body]) => (
          <article class="card p-7 md:col-span-2">
            <span class="feature-icon"><Icon name={icon as 'volume'} /></span>
            <h3 class="mt-5 text-lg font-semibold">{title}</h3>
            <p class="mt-2 leading-relaxed">{body}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- Privacy -->
  <Section id="privacy" label="Privacy by architecture" title="There's no server to trust." intro="Abe isn't private because of a policy. It's private because there is nothing in the middle. Your audio goes from your mic to your computer, then to Whisper on that same computer or straight to the provider you picked.">
    <div class="relative overflow-hidden rounded-2xl bg-surface-lowest p-5 sm:p-10">
      <PrivacyDiagram />
    </div>
    <ul class="mt-6 grid gap-4 md:grid-cols-3">
      {
        [
          ['wifiOff', 'Local mode is offline', 'Pick Local and transcription runs on your CPU or GPU. Unplug the network and it still works.'],
          ['lock', 'Keys in your keychain', 'Your API key is stored by the OS credential manager and only ever sent to its own provider.'],
          ['shield', 'No telemetry', 'No analytics, no crash reporting, no accounts. The only automatic request is the update check to GitHub.'],
        ].map(([icon, title, body]) => (
          <li class="flex gap-4 rounded-2xl bg-surface-low p-6">
            <span class="mt-0.5 text-tertiary"><Icon name={icon as 'lock'} /></span>
            <div>
              <h3 class="font-semibold">{title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed">{body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- Cost -->
  <Section id="cost" label="What it costs" title="Local is free. Cloud is pocket change." intro="Abe never charges you. If you use a cloud provider, you pay them directly at their list price, usually a few cents per hour of talking.">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        priceCards.map((p, i) => {
          const hr = perHour(p);
          return (
            <article class:list={['card flex flex-col p-6', i === 0 && 'local-card']}>
              <p class="label !text-outline">{p.provider === 'Local' ? 'On your computer' : p.provider}</p>
              <h3 class="mt-2 font-mono text-sm font-medium text-on-surface-variant">{p.provider === 'Local' ? 'Local Whisper' : p.model}</h3>
              <p class="mt-6 text-4xl font-semibold tracking-tight text-on-surface">
                {hr === null ? '—' : formatUsd(hr)}
                <span class="text-base font-normal text-outline">/ hour</span>
              </p>
              <p class="mt-auto pt-4 text-xs leading-relaxed text-outline">{p.provider === 'Local' ? 'Offline, no key needed.' : `${formatUsd(p.perMinute ?? 0)} per minute of audio`}</p>
            </article>
          );
        })
      }
    </div>
    <p class="mt-5 text-sm text-outline">
      Provider list prices as of {formatDate(PRICES_AS_OF)}. Check each provider for current rates.{' '}
      <a href="/docs/costs" class="font-medium text-primary underline-offset-4 hover:underline">See all models and the cost calculator</a>
    </p>
  </Section>

  <!-- Open source + Donate -->
  <Section id="open-source" label="Open source" title="Read every line. Change any of them.">
    <div class="grid gap-4 lg:grid-cols-5">
      <article class="card p-7 sm:p-9 lg:col-span-3">
        <p class="leading-relaxed">
          Abe is licensed under the <strong class="text-on-surface">{LICENSE_NAME}</strong>. You can audit exactly where your audio
          goes, build it yourself, and fork it. Bugs, ideas and pull requests are welcome on GitHub.
        </p>
        <pre class="mt-6 overflow-x-auto rounded-xl bg-surface-lowest p-5 font-mono text-[0.82rem] leading-relaxed text-on-surface-variant"><code><span class="text-outline">$</span> git clone {GITHUB_URL}.git
<span class="text-outline">$</span> cd honest-abe && npm install
<span class="text-outline">$</span> npm run tauri dev</code></pre>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href={GITHUB_URL} class="btn btn-ghost"><GitHubIcon size={18} /> Star on GitHub</a>
          <a href="/docs/building-from-source" class="btn btn-ghost"><Icon name="terminal" size={18} /> Build from source</a>
        </div>
      </article>
      <article class="donate-card card relative overflow-hidden p-7 sm:p-9 lg:col-span-2">
        <span class="feature-icon !text-error"><Icon name="heart" /></span>
        <h3 class="mt-5 text-2xl font-semibold">Keep Abe free</h3>
        <p class="mt-3 leading-relaxed">
          Abe is funded by people who find it useful. Donations pay for code-signing certificates, the Apple Developer
          fee, the domain and development time.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href={DONATE_URL} class="btn btn-primary">Donate</a>
          <a href="/donate" class="btn btn-ghost">Where it goes</a>
        </div>
      </article>
    </div>
  </Section>

  <!-- FAQ -->
  <Section id="faq" label="FAQ" title="Questions, answered." narrow>
    <Faq items={FAQ} />
    <p class="mt-6 text-sm text-outline">
      More in the <a href="/docs/faq" class="text-primary underline-offset-4 hover:underline">docs FAQ</a>.
    </p>
  </Section>

  <!-- Final CTA -->
  <section class="mx-auto mt-28 max-w-6xl px-4 sm:px-6" aria-labelledby="cta-title">
    <div class="cta card relative overflow-hidden px-6 py-16 text-center sm:px-12 sm:py-24">
      <KeycapField />
      <div class="relative z-10 mx-auto flex max-w-xl flex-col items-center">
        <h2 id="cta-title" class="text-4xl font-semibold tracking-[-0.03em] sm:text-5xl">Stop typing. Start talking.</h2>
        <p class="mt-4 text-lg">Free, private, and yours to keep.</p>
        <div class="mt-9 flex flex-col items-center gap-4 sm:flex-row sm:items-start">
          <DownloadButton version={release?.version} class="sm:items-start" />
          <a href="/docs/getting-started" class="btn btn-ghost !min-h-[3.4rem] !px-6 !text-base">Read the docs</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 50% at 75% 20%, rgb(80 142 255 / 0.14), transparent 70%),
      radial-gradient(40% 40% at 10% 0%, rgb(174 198 255 / 0.08), transparent 70%),
      linear-gradient(to bottom, transparent 70%, var(--abe-surface));
  }
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgb(140 144 159 / 0.12) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(70% 60% at 60% 30%, black, transparent 75%);
    -webkit-mask-image: radial-gradient(70% 60% at 60% 30%, black, transparent 75%);
  }
  .hero-gradient {
    background: linear-gradient(100deg, #c4d5ff 0%, #8fb2ff 45%, #5d93ff 80%, #4edea3 120%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-bottom: 0.08em;
  }
  .feature-icon {
    display: inline-flex;
    height: 2.75rem;
    width: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.75rem;
    background: var(--abe-surface-high);
    color: var(--abe-primary);
  }
  .local-card {
    background: linear-gradient(160deg, #1b2a26, var(--abe-surface-low) 70%);
  }
  .donate-card {
    background: radial-gradient(80% 70% at 100% 0%, rgb(255 180 171 / 0.09), transparent 70%), var(--abe-surface-low);
  }
  .cta {
    background: radial-gradient(70% 90% at 50% 0%, rgb(80 142 255 / 0.18), transparent 70%), var(--abe-surface-low);
  }
</style>
