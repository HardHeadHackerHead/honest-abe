---
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import BaseLayout from '../layouts/BaseLayout.astro';
import GitHubIcon from '../components/GitHubIcon.astro';
import { GITHUB_RELEASES_URL } from '../config/site';
import { getReleases, formatDate } from '../lib/github';

const releases = await getReleases();
const md = await createMarkdownProcessor({ syntaxHighlight: false });
const rendered = await Promise.all(
  releases.map(async (r) => ({ ...r, html: r.body.trim() ? (await md.render(r.body)).code : '' })),
);
---

<BaseLayout title="Changelog" description="Every Abe release and what changed, generated from GitHub Releases.">
  <div class="mx-auto max-w-3xl px-4 pt-16 sm:px-6 sm:pt-24">
    <p class="label">Changelog</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-[-0.035em] sm:text-6xl">What's new</h1>
    <p class="mt-5 text-lg leading-relaxed">
      Every release, straight from <a href={GITHUB_RELEASES_URL} class="text-primary hover:underline">GitHub Releases</a>.
    </p>

    {
      rendered.length === 0 ? (
        <div class="card mt-14 flex flex-col items-start gap-5 p-8 sm:p-10">
          <h2 class="text-xl font-semibold">Release notes are on the way</h2>
          <p class="leading-relaxed">
            We couldn't load release notes when this page was built. The full list is always available on GitHub.
          </p>
          <a href={GITHUB_RELEASES_URL} class="btn btn-ghost">
            <GitHubIcon size={18} /> View releases on GitHub
          </a>
        </div>
      ) : (
        <ol class="relative mt-14 space-y-6">
          {rendered.map((r, i) => (
            <li class="card p-7 sm:p-9">
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                <h2 class="text-2xl font-semibold tracking-tight">
                  <a href={r.url} class="hover:text-primary">v{r.version}</a>
                </h2>
                {i === 0 && !r.prerelease && <span class="rounded-full bg-tertiary/15 px-2.5 py-0.5 text-xs font-semibold text-tertiary">Latest</span>}
                {r.prerelease && <span class="rounded-full bg-surface-high px-2.5 py-0.5 text-xs font-semibold">Pre-release</span>}
                {r.publishedAt && <time datetime={r.publishedAt} class="text-sm text-outline">{formatDate(r.publishedAt)}</time>}
              </div>
              {r.name !== r.tag && r.name !== `v${r.version}` && <p class="mt-1 text-on-surface">{r.name}</p>}
              {r.html ? <div class="prose-abe mt-4" set:html={r.html} /> : <p class="mt-4 text-outline">No notes for this release.</p>}
            </li>
          ))}
        </ol>
      )
    }
  </div>
</BaseLayout>
